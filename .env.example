# Copy to .env to override. Every value below is already the default, so a
# fresh clone runs without this file. Never commit .env.

# Postgres as seen from the host. Containers always use db:5432.
LEASEDESK_DB_HOST=localhost
LEASEDESK_DB_PORT=5433
LEASEDESK_DB_NAME=leasedesk

# The owner runs migrations and must be allowed to create roles. In Compose it
# is the container's superuser.
LEASEDESK_DB_OWNER=leasedesk
LEASEDESK_DB_OWNER_PASSWORD=leasedesk

# One login per role. Each process connects as exactly one of them.
LEASEDESK_LEASE_AGENT_PASSWORD=lease_agent
LEASEDESK_LEASE_GATEWAY_PASSWORD=lease_gateway
LEASEDESK_LEASE_API_PASSWORD=lease_api
LEASEDESK_LEASE_READER_PASSWORD=lease_reader

LEASEDESK_MINIO_USER=leasedesk
LEASEDESK_MINIO_PASSWORD=leasedesk-dev

LEASEDESK_DATA_DIR=data/generated
LEASEDESK_DEMO_MODE=1

# Signs the login cookie. The default is public; set a long random value
# anywhere but a laptop (python3 -c "import secrets; print(secrets.token_urlsafe(48))").
# COOKIE_SECURE=1 once the app is served over HTTPS.
LEASEDESK_SESSION_SECRET=leasedesk-dev-session-secret-not-for-production
LEASEDESK_COOKIE_SECURE=0

# Only needed for live model calls (extraction, investigation).
ANTHROPIC_API_KEY=

# Copy to .env to override. Every value below is already the default, so a
# fresh clone runs without this file. Never commit .env.

# Postgres as seen from the host. Containers always use db:5432.
LEASEDESK_DB_HOST=localhost
LEASEDESK_DB_PORT=5433
LEASEDESK_DB_NAME=leasedesk

# The owner runs migrations and must be allowed to create roles. In Compose it
# is the container's superuser.
LEASEDESK_DB_OWNER=leasedesk
LEASEDESK_DB_OWNER_PASSWORD=leasedesk

# One login per role. Each process connects as exactly one of them.
LEASEDESK_LEASE_AGENT_PASSWORD=lease_agent
LEASEDESK_LEASE_GATEWAY_PASSWORD=lease_gateway
LEASEDESK_LEASE_API_PASSWORD=lease_api
LEASEDESK_LEASE_READER_PASSWORD=lease_reader

LEASEDESK_MINIO_USER=leasedesk
LEASEDESK_MINIO_PASSWORD=leasedesk-dev

LEASEDESK_DATA_DIR=data/generated
LEASEDESK_DEMO_MODE=1

# Signs the login cookie. The default is public; set a long random value
# anywhere but a laptop (python3 -c "import secrets; print(secrets.token_urlsafe(48))").
# COOKIE_SECURE=1 once the app is served over HTTPS.
LEASEDESK_SESSION_SECRET=leasedesk-dev-session-secret-not-for-production
LEASEDESK_COOKIE_SECURE=0

# Browser origins allowed to call the API with the session cookie, comma
# separated. The default is the Next.js dev server. Never "*".
LEASEDESK_CORS_ORIGINS=http://localhost:3000

# Only needed for live model calls (extraction, investigation).
ANTHROPIC_API_KEY=

# --- Fetch.ai agents (agents_fetch/, C8 + S2). See agents_fetch/README.md.
# `python -m agents_fetch.run` reads this file.
# Shared by the API and the front desk agent: when set, only a caller that
# knows it can redeem pairing codes (POST /api/pairing/claim). Empty = off.
LEASEDESK_PAIRING_CLIENT_KEY=
# Where the agents reach the Lease Desk API.
LEASEDESK_API_URL=http://localhost:8000
# Each agent's seed IS its identity and its Agentverse address. Secrets: generate
# with python3 -c "import secrets; print(secrets.token_urlsafe(32))", never commit.
# The names are the ones the registered agents use; keep them. In order: the
# front desk ("Northbay Lease Desk"), the rulebook, investigation and approvals agents.
AGENT_SEED_COORDINATOR=
AGENT_SEED_RECONCILIATION=
AGENT_SEED_INVESTIGATION=
AGENT_SEED_APPROVALS=
# Addresses (agent1q...), when the agents run as separate processes or hosts and
# do not share seeds. `python -m agents_fetch.runtime addresses` prints them.
LEASEDESK_FRONT_DESK_ADDRESS=
LEASEDESK_RULEBOOK_ADDRESS=
LEASEDESK_INVESTIGATION_ADDRESS=
LEASEDESK_APPROVALS_ADDRESS=
# 1 = connect through the Agentverse mailbox (needed for ASI:One); 0 = local endpoints.
# agents_fetch.run sets it (1, or 0 with --offline).
LEASEDESK_AGENT_MAILBOX=0
# The Bureau's port (agents_fetch.run, agents_fetch.connect).
AGENT_PORT=8001
# Optional: ASI:One's asi1 model reads plain language for the front desk
# (suggestions only; it never triggers an action). Empty = the fixed grammar only.
ASI_ONE_API_KEY=
# Only for `python -m agents_fetch.connect` (agentverse.ai -> Profile -> API Keys).
AGENTVERSE_API_KEY=

# ---- Live mirror (SpacetimeDB, spacetime/README.md). Off unless both are set.
# The API and the worker publish committed work-item state (backend/app/work/live.py);
# the agents publish their steps (agents_fetch/live.py).
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=
# An authorized publisher's token. Secret: never commit.
SPACETIME_TOKEN=
# The web app subscribes (frontend/lib/live.ts); inlined at build time.
NEXT_PUBLIC_SPACETIME_URI=
NEXT_PUBLIC_SPACETIME_DB=
